{
  "info": {
    "name": "BD2-Neopstein API",
    "description": "Collection di richieste per l'API REST BD2-Neopstein: endpoint di analisi e CRUD sul grafo email del caso Epstein (Person, Mail, Cluster).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Cluster",
      "item": [
        {
          "name": "Mail di un cluster",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/clusters/1/mails",
            "description": "Restituisce le mail appartenenti al cluster con id 1."
          }
        },
        {
          "name": "Persone di un cluster",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/clusters/1/persons",
            "description": "Restituisce le persone coinvolte nelle mail del cluster con id 1."
          }
        },
        {
          "name": "Classifica cluster per redazioni",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/clusters/top-redacted",
            "description": "Restituisce i cluster ordinati per numero totale di redazioni."
          }
        },
        {
          "name": "Crea un cluster",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/clusters",
            "description": "Crea un nuovo nodo Cluster.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cluster_id\": 1,\n  \"label\": \"Finance\"\n}"
            }
          }
        },
        {
          "name": "Dettaglio di un cluster",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/clusters/1",
            "description": "Restituisce le proprietà del cluster con id 1."
          }
        },
        {
          "name": "Aggiorna un cluster",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/clusters/1",
            "description": "Aggiorna la label del cluster con id 1.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Finance Updated\"\n}"
            }
          }
        },
        {
          "name": "Elimina un cluster",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/clusters/1",
            "description": "Elimina il cluster con id 1."
          }
        }
      ]
    },
    {
