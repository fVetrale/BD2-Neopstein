              "raw": "{\n  \"id\": \"001612df62eb14194162f0a366793927\",\n  \"subject\": \"Meeting notes\",\n  \"body\": \"See attached.\",\n  \"sent_at\": \"2015-03-04T10:00:00\",\n  \"redaction_count\": 0,\n  \"redaction_ratio\": 0.0,\n  \"attachment_count\": 1,\n  \"is_promotional\": false\n}"
